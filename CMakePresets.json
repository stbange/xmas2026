{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "linux-debug",
      "inherits": "base",
      "displayName": "Linux debug",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "TB_PLAYTEST_BUILD": "ON"
      }
    },
    {
      "name": "linux-release",
      "inherits": "base",
      "displayName": "Linux release",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-coverage",
      "inherits": "base",
      "displayName": "Linux coverage",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "gcc",
        "TB_COVERAGE": "ON"
      }
    },
    {
      "name": "linux-sanitize",
      "inherits": "base",
      "displayName": "Linux ASan+UBSan",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "clang",
        "TB_SANITIZE": "ON"
      }
    },
    {
      "name": "windows-msvc",
      "inherits": "base",
      "displayName": "Windows MSVC",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "web-release",
      "inherits": "base",
      "displayName": "Web (Emscripten) release",
      "generator": "Ninja",
      "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "TB_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "web-playtest",
      "inherits": "web-release",
      "displayName": "Web (Emscripten) playtest build",
      "cacheVariables": {
        "TB_PLAYTEST_BUILD": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug"
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release"
    },
    {
      "name": "linux-coverage",
      "configurePreset": "linux-coverage"
    },
    {
      "name": "linux-sanitize",
      "configurePreset": "linux-sanitize"
    },
    {
      "name": "windows-msvc",
      "configurePreset": "windows-msvc",
      "configuration": "Debug"
    },
    {
      "name": "web-release",
      "configurePreset": "web-release"
    },
    {
      "name": "web-playtest",
      "configurePreset": "web-playtest"
    }
  ],
  "testPresets": [
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-coverage",
      "configurePreset": "linux-coverage",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-sanitize",
      "configurePreset": "linux-sanitize",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-msvc",
      "configurePreset": "windows-msvc",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
